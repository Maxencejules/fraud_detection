# Copy to .env to override Compose defaults. Every variable is optional.

# --- logging -------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- traffic simulation --------------------------------------------------------------
# Transactions per second published by the producer (wall clock).
EMIT_RATE_TPS=20
# Simulated population (must match between bootstrap and producer).
SIM_SEED=42
SIM_USERS=3000
SIM_MERCHANTS=600
# Days of simulated history used for the training set and the Redis backfill.
HISTORY_DAYS=45
# End of that history as a Unix timestamp (empty = now). Pin it for reproducible runs,
# e.g. 1767225600 = 2026-01-01T00:00:00Z.
HISTORY_END=

# --- decision policy (calibrated fraud probability) ----------------------------------
THRESHOLD_REVIEW=0.1
THRESHOLD_BLOCK=0.9

# --- predictor -----------------------------------------------------------------------
# Seconds between registry checks for a newly promoted champion.
MODEL_POLL_INTERVAL_S=15
# Enables POST /v1/admin/reload when set (at least 16 characters). Leave empty to disable.
ADMIN_TOKEN=

# --- monitoring ----------------------------------------------------------------------
MONITOR_REPORT_INTERVAL_S=300
MONITOR_MIN_ROWS=200
MONITOR_WINDOW_SIZE=2000

# --- local credentials (development only; change for any shared deployment) ---------
POSTGRES_PASSWORD=mlflow
GRAFANA_ADMIN_PASSWORD=admin
